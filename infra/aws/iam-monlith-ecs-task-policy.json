{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OptionalS3ActiveStorage",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_MONLITH_UPLOADS_BUCKET",
        "arn:aws:s3:::REPLACE_MONLITH_UPLOADS_BUCKET/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
