RAILS_ENV=development

# Copy from config/master.key after: bin/rails credentials:edit
RAILS_MASTER_KEY=

DEVISE_JWT_SECRET_KEY=development-jwt-secret-change-in-production

FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=development-ai-secret-change-in-production

# Docker Compose sets DATABASE_URL and REDIS_URL on backend/sidekiq services.
# Host-only development:
# DATABASE_URL=postgresql://postgres:password@localhost:5434/ai_workspace_development
# REDIS_URL=redis://localhost:6380/1
