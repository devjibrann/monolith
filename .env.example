# Copy to .env in the project root (never commit .env):
#   cp .env.example .env
#
# Pick one provider (ai-service reads these via Docker Compose).
# After changing provider or embedding model, re-upload documents so vectors match queries.

# openai | gemini | nvidia | ollama | mock  (empty = auto-detect from keys below)
AI_PROVIDER=
# Optional split: e.g. EMBEDDING_PROVIDER=gemini + CHAT_PROVIDER=ollama
# EMBEDDING_PROVIDER=
# CHAT_PROVIDER=

# --- OpenAI (default) ---
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Gemini (https://aistudio.google.com/apikey) ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- NVIDIA NIM (free tier, OpenAI-compatible) ---
# https://build.nvidia.com — create API key
# AI_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# --- Ollama (local, OpenAI-compatible) ---
# AI_PROVIDER=ollama
# Run on host: ollama pull llama3.2 && ollama pull nomic-embed-text
# Or with Compose profile: docker compose --profile ollama up -d
#   then set OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Mock embeddings + chat (no external API). Re-upload documents after enabling.
# USE_MOCK_EMBEDDINGS=true

# pgvector column size (default 1536). Ollama models may return fewer dims (padded automatically).
# EMBEDDING_DIMENSIONS=1536
