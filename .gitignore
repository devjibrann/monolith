# =============================================================================
# Monlith — root .gitignore (Rails + Next.js + FastAPI + Docker)
# Commit only: .env.example, config/credentials.yml.enc (not master.key)
# =============================================================================

# --- Secrets & environment (never commit) ---
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.*
!backend/.env.example
backend/config/master.key
backend/config/credentials/*.key
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.local.example
ai-service/.env
ai-service/.env.*

# Keys & certs
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# --- Ruby / Rails (backend) ---
backend/vendor/bundle/
backend/.bundle/
backend/tmp/
backend/log/
backend/storage/*
!backend/storage/.keep
backend/public/assets/
backend/public/packs/
backend/public/packs-test/
backend/node_modules/
backend/.byebug_history
backend/.rspec_status
backend/coverage/
backend/spec/examples.txt
*.gem
.ruby-version.local

# --- Node / Next.js (frontend) ---
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.turbo/
frontend/.vercel/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.*

# --- Python (ai-service) ---
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/*.py[cod]
ai-service/.venv/
ai-service/venv/
ai-service/.pytest_cache/
ai-service/.mypy_cache/
ai-service/.ruff_cache/
ai-service/htmlcov/
ai-service/.coverage
ai-service/*.egg-info/
ai-service/dist/
ai-service/build/
.python-version.local

# --- Docker (local named volumes / exports) ---
postgres_data/
redis_data/
ollama_data/
*.tar
docker-compose.override.yml
docker-compose.*.local.yml

# --- AWS / deploy artifacts (generated locally) ---
.aws/
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json

# --- Impeccable / design tooling (local runs) ---
.impeccable/
frontend/.impeccable/
**/.impeccable/critique/

# --- Cursor / IDE (keep .cursor/skills if you version project skills) ---
.cursor/projects/
.cursor/plans/
.cursor/*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- OS ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs & temp ---
*.log
logs/
tmp/
temp/
.cache/

# --- Test / coverage (repo root) ---
coverage/
.nyc_output/
.cursor/
